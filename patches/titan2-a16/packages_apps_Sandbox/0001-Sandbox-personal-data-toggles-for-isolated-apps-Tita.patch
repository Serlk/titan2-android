+                val sandboxManager = remember {
+                    context.getSystemService(android.app.AxSandboxManager::class.java)
+                }
+                DataScopesDropdown(
+                    app = app,
+                    sandboxManager = sandboxManager
+                )
+            }
         }
 }
 
