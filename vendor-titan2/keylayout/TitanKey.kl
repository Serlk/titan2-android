# Titan 2 keyboard (aw9523_key) scan codes; Sym=SYM (keycode 63), Fn=CTRL_LEFT (keycode 113),
# the firmware defaults; labels valid on A16 (AGUI_SYM/FUNC3 = 323/321 are taken in A16).

# POWER: with the screen off aw9523_key wakes the phone with a key (wake_up_enable,
# "Alt key wake keyboard") and sends KEY_POWER.
key 116   POWER

# ROW1
key 42    SHIFT_LEFT
key 253   SYM
key 158   BACK
key 580   APP_SWITCH
key 251   CTRL_LEFT
key 100   ALT_RIGHT

# ROW2
key 16    Q
key 17    W
key 18    E
key 19    R
key 20    T
key 21    Y
key 22    U
key 23    I
key 24    O
key 25    P

# ROW3
key 30    A
key 31    S
key 32    D
key 33    F
key 34    G
key 35    H
key 36    J
key 37    K
key 38    L
key 14    DEL

# ROW4
key 44    Z
key 45    X
key 46    C
key 47    V
key 57    SPACE
key 48    B
key 49    N
key 50    M
key 28    ENTER

