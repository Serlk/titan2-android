From 91ac0f1f45136f6b06e643f03d4a3b63011e87bf Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Mon, 19 Oct 2026 02:46:40 +0300
Subject: [PATCH] lxc template: device allowlist via cgroup2 keys

GKI has no cgroup v1 devices controller; lxc.cgroup.devices.* made lxc_spawn fail with
'Failed to setup legacy device cgroup controller limits'.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lxc/template.sh | 33 +++++++++++++++------------------
 1 file changed, 15 insertions(+), 18 deletions(-)

diff --git a/lxc/template.sh b/lxc/template.sh
index 7510939..a9af1c3 100755
--- a/lxc/template.sh
+++ b/lxc/template.sh
@@ -365,37 +365,34 @@ lxc.mount.entry = /sdcard mnt/sdcard none bind,optional,rw,create=dir
 # Allow for 1024 pseudo terminals
 lxc.pty.max = 1024
 
-# CGroup allowlist
-#lxc.cgroup.devices.deny = a TODO do not allow all device operations by default
+# CGroup allowlist: cgroup2 (BPF device controller). GKI kernels have no cgroup v1 devices
+# controller, and lxc refuses to start when v1 devices keys are present without it.
+#lxc.cgroup2.devices.deny = a TODO do not allow all device operations by default
 ## Allow any mknod (but not reading/writing the node)
-lxc.cgroup.devices.allow = c *:* m
-lxc.cgroup.devices.allow = b *:* m
+lxc.cgroup2.devices.allow = c *:* m
+lxc.cgroup2.devices.allow = b *:* m
 ## Allow specific devices
 ### /dev/null
-lxc.cgroup.devices.allow = c 1:3 rwm
+lxc.cgroup2.devices.allow = c 1:3 rwm
 ### /dev/zero
-lxc.cgroup.devices.allow = c 1:5 rwm
+lxc.cgroup2.devices.allow = c 1:5 rwm
 ### /dev/full
-lxc.cgroup.devices.allow = c 1:7 rwm
+lxc.cgroup2.devices.allow = c 1:7 rwm
 ### /dev/tty
-lxc.cgroup.devices.allow = c 5:0 rwm
+lxc.cgroup2.devices.allow = c 5:0 rwm
 ### /dev/console
-lxc.cgroup.devices.allow = c 5:1 rwm
+lxc.cgroup2.devices.allow = c 5:1 rwm
 ### /dev/ptmx
-lxc.cgroup.devices.allow = c 5:2 rwm
+lxc.cgroup2.devices.allow = c 5:2 rwm
 ### /dev/random
-lxc.cgroup.devices.allow = c 1:8 rwm
+lxc.cgroup2.devices.allow = c 1:8 rwm
 ### /dev/urandom
-lxc.cgroup.devices.allow = c 1:9 rwm
+lxc.cgroup2.devices.allow = c 1:9 rwm
 ### /dev/pts/*
-lxc.cgroup.devices.allow = c 136:* rwm
+lxc.cgroup2.devices.allow = c 136:* rwm
 ### fuse
-lxc.cgroup.devices.allow = c 10:229 rwm
+lxc.cgroup2.devices.allow = c 10:229 rwm
 ### USB for libusb (RTL-SDR, Flipper RPC, NFC readers) and USB serial (CDC ACM, FTDI/CH34x).
-### The cgroup2 keys too: GKI kernels run without the v1 devices controller.
-lxc.cgroup.devices.allow = c 189:* rwm
-lxc.cgroup.devices.allow = c 166:* rwm
-lxc.cgroup.devices.allow = c 188:* rwm
 lxc.cgroup2.devices.allow = c 189:* rwm
 lxc.cgroup2.devices.allow = c 166:* rwm
 lxc.cgroup2.devices.allow = c 188:* rwm
-- 
