+
+    // Titan 2: caller checks of the binder interface.
+
+    /**
+     * Held by SystemUI and the recents launcher (signature|recents): they ask for the lock state
+     * of other apps, listen to lock / session changes and ask for the unlock prompt.
+     */
+    private static final String PERMISSION_SYSTEM_UI = android.Manifest.permission.STATUS_BAR_SERVICE;
+
+    /** system_server or an android.uid.system app (the Sandbox manager, AppLocker), any user. */
+    private static boolean isCallerSystem() {
+        return UserHandle.getAppId(Binder.getCallingUid()) == Process.SYSTEM_UID;
+    }
+
+    private static void enforceSystem(String method) {
+        if (!isCallerSystem()) {
+            throw new SecurityException("AxSandbox." + method + ": uid "
+                    + Binder.getCallingUid() + " is not the system");
+        }
+    }
+
+    private boolean isCallerGranted(String permission) {
+        return mContext != null && mContext.checkCallingPermission(permission)
+                == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private void enforceSystemOrSystemUi(String method) {
+        if (!isCallerSystem() && !isCallerGranted(PERMISSION_SYSTEM_UI)) {
+            throw new SecurityException("AxSandbox." + method + ": uid "
+                    + Binder.getCallingUid() + " is not the system and lacks "
+                    + PERMISSION_SYSTEM_UI);
+        }
+    }
+
+    /** Whether packageName belongs to the calling uid (an app asking about itself). */
+    private boolean isCallerPackage(String packageName) {
+        if (TextUtils.isEmpty(packageName) || mContext == null) return false;
+        final int callingUid = Binder.getCallingUid();
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final String[] packages = mContext.getPackageManager().getPackagesForUid(callingUid);
+            if (packages == null) return false;
+            for (String p : packages) {
+                if (packageName.equals(p)) return true;
+            }
+            return false;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    /** A query about packageName: the system, the package itself or (if given) a permission. */
+    private void enforceQuery(String method, String packageName, String permission) {
+        if (isCallerSystem() || isCallerPackage(packageName)
+                || (permission != null && isCallerGranted(permission))) {
+            return;
+        }
+        throw new SecurityException("AxSandbox." + method + ": uid " + Binder.getCallingUid()
+                + " may not query " + packageName);
+    }
+
+    /**
+     * The binder interface {@link Context#AX_SANDBOX_SERVICE}. The service policy alone lets
+     * platform, GMS, NFC and Bluetooth apps reach it, so every call checks the caller:
+     * <ul>
+     * <li>state changes (lock/hide/isolate an app, its scopes, gids, data isolation, unlock,
+     *     hidden notifications) and the lists of all apps: system uid only, that is
+     *     system_server and the platform-signed android.uid.system apps (Sandbox, AppLocker).
+     *     system_server itself uses the methods of {@link AxSandboxService} directly.
+     * <li>the unlock prompt, the lock state of other apps and the lock / session listeners:
+     *     also SystemUI and the recents launcher ({@link #PERMISSION_SYSTEM_UI}).
+     * <li>queries about one package: the system or that package itself. SettingsProvider runs
+     *     in system_server but calls getSpoofedSetting through this interface while it serves
+     *     the app, i.e. with the app's identity and the app's own package: allowed as "itself".
+     * </ul>
+     * State changes run with a cleared calling identity, as system_server.
+     */
+    private final class BinderService extends IAxSandboxManager.Stub {
+        @Override
+        public int getAppLockState(String packageName) {
+            enforceQuery("getAppLockState", packageName, PERMISSION_SYSTEM_UI);
+            final int userId = UserHandle.getCallingUserId();
+            final long token = Binder.clearCallingIdentity();
+            try {
+                return AxSandboxService.this.getAppLockStateForUser(packageName, userId);
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+        }
+
+        @Override
+        public int getAppLockStateForUser(String packageName, int userId) {
+            if (userId != UserHandle.getCallingUserId()) {
+                enforceSystemOrSystemUi("getAppLockStateForUser");
+            } else {
+                enforceQuery("getAppLockStateForUser", packageName, PERMISSION_SYSTEM_UI);
+            }
+            final long token = Binder.clearCallingIdentity();
+            try {
+                return AxSandboxService.this.getAppLockStateForUser(packageName, userId);
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+        }
+
