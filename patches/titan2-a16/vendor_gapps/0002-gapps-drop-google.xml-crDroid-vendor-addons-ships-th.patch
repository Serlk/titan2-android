From c2eed989bfb97d07e335df9215e5d96256026f82 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Sun, 18 Oct 2026 15:01:25 +0300
Subject: [PATCH] gapps: drop google.xml (crDroid vendor/addons ships the Pixel
 superset)

---
 common/Android.bp       | 8 +-------
 common/common-vendor.mk | 1 -
 2 files changed, 1 insertion(+), 8 deletions(-)

diff --git a/common/Android.bp b/common/Android.bp
index 530614b..04cccd9 100644
--- a/common/Android.bp
+++ b/common/Android.bp
@@ -180,13 +180,7 @@ prebuilt_etc {
     product_specific: true,
 }
 
-prebuilt_etc {
-    name: "google.xml",
-    src: "proprietary/product/etc/sysconfig/google.xml",
-    relative_install_path: "sysconfig",
-    filename_from_src: true,
-    product_specific: true,
-}
+// google.xml: installed by crDroid vendor/addons (the Pixel variant, a superset)
 
 prebuilt_etc {
     name: "privapp-permissions-google-product.xml",
diff --git a/common/common-vendor.mk b/common/common-vendor.mk
index ba808c9..c0aaaba 100644
--- a/common/common-vendor.mk
+++ b/common/common-vendor.mk
@@ -20,7 +20,6 @@ PRODUCT_PACKAGES += \
     gapps.rc \
     gms_fsverity_cert.der \
     google-hiddenapi-package-allowlist.xml \
-    google.xml \
     privapp-permissions-google-product.xml \
     privapp-permissions-google-system-ext.xml \
     privapp-permissions-mtg.xml \
-- 
2.56.0

