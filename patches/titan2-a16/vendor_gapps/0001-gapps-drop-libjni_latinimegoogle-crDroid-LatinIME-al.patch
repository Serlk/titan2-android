From f7600fbd81ef0cfbf4900f9aa538b58c53fac565 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Sat, 17 Oct 2026 17:48:27 +0000
Subject: [PATCH] gapps: drop libjni_latinimegoogle (crDroid LatinIME already
 provides it)

---
 arm/Android.bp        | 7 -------
 arm/arm-vendor.mk     | 3 +--
 arm64/Android.bp      | 7 -------
 arm64/arm64-vendor.mk | 3 +--
 4 files changed, 2 insertions(+), 18 deletions(-)

diff --git a/arm/Android.bp b/arm/Android.bp
index 9eb17be..8ac9ea5 100644
--- a/arm/Android.bp
+++ b/arm/Android.bp
@@ -80,10 +80,3 @@ android_app_import {
     },
     product_specific: true,
 }
-
-cc_prebuilt_library_shared {
-    name: "libjni_latinimegoogle",
-    srcs: ["proprietary/product/lib/libjni_latinimegoogle.so"],
-    prefer: true,
-    product_specific: true,
-}
diff --git a/arm/arm-vendor.mk b/arm/arm-vendor.mk
index 1ad7ba6..4e559d2 100644
--- a/arm/arm-vendor.mk
+++ b/arm/arm-vendor.mk
@@ -6,8 +6,7 @@ PRODUCT_SOONG_NAMESPACES += \
 
 PRODUCT_PACKAGES += \
     GmsCore \
-    Phonesky \
-    libjni_latinimegoogle
+    Phonesky
 
 ifeq ($(TARGET_IS_GROUPER),)
 PRODUCT_PACKAGES += \
diff --git a/arm64/Android.bp b/arm64/Android.bp
index 5646a29..e942c16 100644
--- a/arm64/Android.bp
+++ b/arm64/Android.bp
@@ -106,10 +106,3 @@ android_app_import {
     },
     product_specific: true,
 }
-
-cc_prebuilt_library_shared {
-    name: "libjni_latinimegoogle",
-    srcs: ["proprietary/product/lib64/libjni_latinimegoogle.so"],
-    prefer: true,
-    product_specific: true,
-}
diff --git a/arm64/arm64-vendor.mk b/arm64/arm64-vendor.mk
index af0154a..a6f9aa6 100644
--- a/arm64/arm64-vendor.mk
+++ b/arm64/arm64-vendor.mk
@@ -6,8 +6,7 @@ PRODUCT_SOONG_NAMESPACES += \
 
 PRODUCT_PACKAGES += \
     GmsCore \
-    Phonesky \
-    libjni_latinimegoogle
+    Phonesky
 
 ifeq ($(TARGET_IS_GROUPER),)
 PRODUCT_PACKAGES += \
-- 
2.34.1

