diff --git a/src/com/android/axion/sandbox/ui/SandboxApp.kt b/src/com/android/axion/sandbox/ui/SandboxApp.kt
index 8f6b54d..d335d1d 100644
--- a/src/com/android/axion/sandbox/ui/SandboxApp.kt
+++ b/src/com/android/axion/sandbox/ui/SandboxApp.kt
@@ -638,6 +638,66 @@ private val SPOOF_ACCESSIBILITY_KEYS = listOf(
     "accessibility_display_inversion_enabled"
 )
 
+// Titan 2: personal data of an isolated app. Off = the permission stays granted but the
+// system returns empty data / no location (AppOpsService, "titan2_allow_<scope>" keys).
+private val DATA_SCOPES = listOf(
+    SpoofSettingEntry("titan2_allow_contacts",
+            R.string.scope_contacts, R.string.scope_contacts_description),
+    SpoofSettingEntry("titan2_allow_call_log",
+            R.string.scope_call_log, R.string.scope_call_log_description),
+    SpoofSettingEntry("titan2_allow_sms",
+            R.string.scope_sms, R.string.scope_sms_description),
+    SpoofSettingEntry("titan2_allow_calendar",
+            R.string.scope_calendar, R.string.scope_calendar_description),
+    SpoofSettingEntry("titan2_allow_location",
+            R.string.scope_location, R.string.scope_location_description),
+    SpoofSettingEntry("titan2_allow_files",
+            R.string.scope_files, R.string.scope_files_description)
+)
+
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+@Composable
+private fun DataScopesDropdown(
+    app: AppInfo,
+    sandboxManager: android.app.AxSandboxManager?
+) {
+    if (sandboxManager == null) return
+
+    val scope = rememberCoroutineScope()
+    val allowed = remember(app.packageName) {
+        mutableStateMapOf<String, Boolean>().apply {
+            DATA_SCOPES.forEach { entry ->
+                put(entry.key, sandboxManager.isSpoofSettingEnabled(app.packageName, entry.key))
+            }
+        }
+    }
+
+    PreferenceGroup(
+        title = stringResource(R.string.scopes_title),
+        collapsible = true,
+        initiallyExpanded = false,
+    ) {
+        DATA_SCOPES.forEach { entry ->
+            item {
+                val isAllowed = allowed[entry.key] ?: false
+                SwitchPreference(
+                    title = stringResource(entry.titleRes),
+                    summary = stringResource(entry.descriptionRes),
+                    checked = isAllowed,
+                    onCheckedChange = {
+                        val newValue = !isAllowed
+                        allowed[entry.key] = newValue
+                        scope.launch(Dispatchers.IO) {
+                            sandboxManager.setSpoofSettingEnabled(
+                                    app.packageName, entry.key, newValue)
+                        }
+                    },
+                )
+            }
+        }
+    }
+}
+
 @OptIn(ExperimentalMaterial3ExpressiveApi::class)
 @Composable
 private fun SpoofSettingsDropdown(
@@ -830,6 +890,17 @@ fun AppDetailScreen(
                 )
             }
 
+            item {
