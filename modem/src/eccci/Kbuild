	-I$(MTK)/memory-amms -I$(MTK)/mdpm -I$(MTK)/pbm -I$(MTK)/slbc \
	-I$(MTK)/pmic -I$(DEVICE_MODULES_PATH)/drivers/clk/mediatek

obj-m += ccci_auxadc.o
