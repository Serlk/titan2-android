From 7292d1aff484121b5ac072348277a9199c0a17b4 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Sun, 18 Oct 2026 15:00:27 +0300
Subject: [PATCH] GSI (crDroid 16): explicit LOCAL_PATH, sepolicy to
 system_ext, perspectived init:dir read-only

---
 lindroid.mk              | 7 ++++++-
 sepolicy/perspectived.te | 4 ++--
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/lindroid.mk b/lindroid.mk
index 90e9359..22cbde2 100644
--- a/lindroid.mk
+++ b/lindroid.mk
@@ -1,3 +1,6 @@
+# Included via inherit-product: my-dir is empty there, so the path is explicit.
+LOCAL_PATH := vendor/lindroid
+
 # LXC Tools
 PRODUCT_PACKAGES += \
     lxc_attach \
@@ -47,5 +50,7 @@ PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/disabled.idc:$(TARGET_COPY_OUT_SYSTEM)/usr/idc/Vendor_000a_Product_000c.idc \
     $(LOCAL_PATH)/configs/disabled.idc:$(TARGET_COPY_OUT_SYSTEM)/usr/idc/Vendor_000a_Product_000d.idc
 
-BOARD_SEPOLICY_DIRS += \
+# perspectived is a coredomain: the policy must live in system_ext, not in vendor
+# (on a GSI the vendor policy is stock and is not rebuilt).
+SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += \
        vendor/lindroid/sepolicy
diff --git a/sepolicy/perspectived.te b/sepolicy/perspectived.te
index 8561178..c2f4af7 100644
--- a/sepolicy/perspectived.te
+++ b/sepolicy/perspectived.te
@@ -1,7 +1,6 @@
 # perspectived
 type perspectived, domain;
 typeattribute perspectived coredomain;
-typeattribute perspectived init_dir_mutation_exempt;
 type perspectived_exec, exec_type, file_type, system_file_type;
 
 init_daemon_domain(perspectived)
@@ -18,7 +17,8 @@ allow perspectived self:netlink_kobject_uevent_socket { create setopt bind read
 allow perspectived self:capability { net_admin chown fsetid fowner sys_admin sys_resource kill };
 
 allow perspectived init:file r_file_perms;
-allow perspectived init:dir w_dir_perms;
+# neverallow domain domain:dir write: read access is enough (as in the Razr Fold port on LOS 23.2)
+allow perspectived init:dir r_dir_perms;
 
 allow perspectived shell_exec:file rx_file_perms;
 
-- 
2.56.0

