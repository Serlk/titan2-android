+
+enum ksu_feature_id {
+    KSU_FEATURE_SU_COMPAT = 0,
+    KSU_FEATURE_KERNEL_UMOUNT = 1,
+    KSU_FEATURE_SULOG = 2,
+    KSU_FEATURE_ADB_ROOT = 3,
+    KSU_FEATURE_SELINUX_HIDE = 4,
+    KSU_FEATURE_WEBVIEW_ZYGOTE_UMOUNT = 5,
+
+    KSU_FEATURE_MAX
+};
+
+#endif
