From e1a88803409ff0550f51b39e687e0dcda6ca8147 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:22:27 +0300
Subject: [PATCH] Titan 2: sys.titan2.focus from the activity/process,
 byte-safe

LayoutParams.packageName is client-controlled; take the package from the
focused activity or the window's process. The property limit is in UTF-8
bytes and set() throws under the WM lock on overflow: trim by bytes and
catch failures.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../com/android/server/wm/DisplayContent.java | 21 ++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/services/core/java/com/android/server/wm/DisplayContent.java b/services/core/java/com/android/server/wm/DisplayContent.java
index 49709808b..d1d26d4d7 100644
--- a/services/core/java/com/android/server/wm/DisplayContent.java
+++ b/services/core/java/com/android/server/wm/DisplayContent.java
@@ -4074,17 +4074,28 @@ class DisplayContent extends RootDisplayArea implements WindowManagerPolicy.Disp
         mCurrentFocus = newFocus;
         if (isDefaultDisplay) {
             // Titan 2: focused package for the per-app keyboard touchpad modes (Titan2Parts)
+            // LayoutParams.packageName is chosen by the client, so take the package from the
+            // activity or the window's process instead.
             String focus = "";
             if (newFocus != null) {
-                focus = newFocus.getOwningPackage();
-                if (focus == null) {
+                if (newFocus.mActivityRecord != null) {
+                    focus = newFocus.mActivityRecord.packageName;
+                } else if (newFocus.mSession.mPackageName != null) {
+                    focus = newFocus.mSession.mPackageName;
+                } else {
                     focus = String.valueOf(newFocus.getWindowTag());
                 }
             }
-            if (focus.length() > android.os.SystemProperties.PROP_VALUE_MAX) {
-                focus = focus.substring(0, android.os.SystemProperties.PROP_VALUE_MAX);
+            // The limit is in UTF-8 bytes; an over-long value would throw under the WM lock.
+            while (focus.getBytes(java.nio.charset.StandardCharsets.UTF_8).length
+                    > android.os.SystemProperties.PROP_VALUE_MAX) {
+                focus = focus.substring(0, focus.length() - 1);
+            }
+            try {
+                android.os.SystemProperties.set("sys.titan2.focus", focus);
+            } catch (RuntimeException e) {
+                Slog.w(TAG_WM, "sys.titan2.focus", e);
             }
-            android.os.SystemProperties.set("sys.titan2.focus", focus);
         }
 
         if (newFocus != null) {
