From f5ccf8e76ee1d35bc05b76ef8435240593db19d0 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:22:27 +0300
Subject: [PATCH] app/ClipboardBridge: never write or read through symlinks

The clipboard directory is shared with the container. Write a fresh
O_EXCL temp file and rename it over android.txt; read linux.txt with
NOFOLLOW_LINKS, so a planted symlink cannot redirect system-uid I/O.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../java/org/lindroid/ui/ClipboardBridge.java | 31 ++++++++++++++-----
 1 file changed, 23 insertions(+), 8 deletions(-)

diff --git a/app/app/src/main/java/org/lindroid/ui/ClipboardBridge.java b/app/app/src/main/java/org/lindroid/ui/ClipboardBridge.java
index cd44d9d..648f1e0 100644
--- a/app/app/src/main/java/org/lindroid/ui/ClipboardBridge.java
+++ b/app/app/src/main/java/org/lindroid/ui/ClipboardBridge.java
@@ -6,10 +6,13 @@ import android.content.Context;
 import android.util.Log;
 
 import java.io.File;
-import java.io.FileOutputStream;
 import java.io.IOException;
+import java.io.InputStream;
 import java.nio.charset.StandardCharsets;
 import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
 
 /**
  * Text clipboard sync between Android and the Linux container through the shared Lindroid
@@ -46,13 +49,21 @@ final class ClipboardBridge {
             if (text == null || text.isEmpty() || text.equals(sLastSent)) {
                 return;
             }
-            File tmp = new File(DIR, "android.txt.tmp");
-            try (FileOutputStream out = new FileOutputStream(tmp)) {
-                out.write(text.getBytes(StandardCharsets.UTF_8));
-            }
-            tmp.setReadable(true, false);
-            if (tmp.renameTo(TO_LINUX)) {
+            // The directory is shared with the container: write a fresh randomly named file
+            // (O_EXCL, never through a planted symlink) and rename it over android.txt.
+            Path tmp = Files.createTempFile(DIR.toPath(), ".android.", ".tmp");
+            try {
+                Files.write(tmp, text.getBytes(StandardCharsets.UTF_8),
+                        LinkOption.NOFOLLOW_LINKS);
+                tmp.toFile().setReadable(true, false);
+                Files.move(tmp, TO_LINUX.toPath(), StandardCopyOption.REPLACE_EXISTING,
+                        StandardCopyOption.ATOMIC_MOVE);
+                tmp = null;
                 sLastSent = text;
+            } finally {
+                if (tmp != null) {
+                    Files.deleteIfExists(tmp);
+                }
             }
         } catch (IOException | RuntimeException e) {
             Log.w(TAG, "to Linux", e);
@@ -66,7 +77,11 @@ final class ClipboardBridge {
                 return;
             }
             sLastApplied = m;
-            String text = new String(Files.readAllBytes(FROM_LINUX.toPath()), StandardCharsets.UTF_8);
+            String text;
+            try (InputStream in = Files.newInputStream(FROM_LINUX.toPath(),
+                    LinkOption.NOFOLLOW_LINKS)) {
+                text = new String(in.readAllBytes(), StandardCharsets.UTF_8);
+            }
             if (text.isEmpty() || text.equals(sLastSent)) {
                 return;
             }
