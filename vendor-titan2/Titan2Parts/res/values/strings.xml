    <string name="chord_in_fields_title">Also in text fields</string>
    <string name="chord_in_fields_summary">Off: chords work only while no text field is active, so Sym stays with Plektra while typing. On: assigned letters are taken from Plektra too (text snippets need this). Plektra still sees the Sym press itself and may open its symbol page.</string>
    <string name="chord_text">Text snippet</string>
    <string name="chord_text_hint">e.g. Best regards, {date}</string>
    <string name="chord_text_help">Inserted through the clipboard (Ctrl+V); the clipboard is restored after a second. {date} and {time} are replaced with the current date and time, {date:dd.MM.yyyy} or {time:HH:mm} use your own pattern.</string>
    <string name="space_long_layout_title">Hold space to switch layout</string>
    <string name="space_long_layout_summary">While typing, holding the space bar for half a second switches to the next keyboard layout or language (like Ctrl+Space). Space no longer auto-repeats and is typed when released.</string>
