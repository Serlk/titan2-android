-	libutils \
-	libgui \
-	libandroidfw
-
-static_libraries := \
-	libgtest \
-	libgtest_main
-
-
-ifeq ($(shell test $(ANDROID_VERSION_MAJOR) -ge 10 && echo true),true)
-static_libraries += \
-	libskia
-else
-LOCAL_SHARED_LIBRARIES += \
-	libskia
-endif
-
-include $(BUILD_EXECUTABLE)
diff --git a/compat/media/Android.mk b/compat/media/Android.mk
