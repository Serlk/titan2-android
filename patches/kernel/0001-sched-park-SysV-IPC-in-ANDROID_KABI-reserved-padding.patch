From 23f7cc217b1429d3b1c094e074645f945500d618 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Sat, 17 Oct 2026 15:55:48 +0300
Subject: [PATCH 1/3] sched: park SysV IPC in ANDROID_KABI reserved padding

From LuneOS meta-smartphone PR #3 (codepoet80), keeps KMI with CONFIG_SYSVIPC=y.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/linux/sched.h | 32 +++++++++++++++++++++++++-------
 1 file changed, 25 insertions(+), 7 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 464d41843..49b102ff9 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -1096,10 +1096,11 @@ struct task_struct {
 
 	struct nameidata		*nameidata;
 
-#ifdef CONFIG_SYSVIPC
-	struct sysv_sem			sysvsem;
-	struct sysv_shm			sysvshm;
-#endif
+	/*
+	 * LuneOS: sysvsem/sysvshm (CONFIG_SYSVIPC) would normally live here.
+	 * Inserting them mid-struct shifts every following member and breaks
+	 * the frozen KMI, so they are parked in ANDROID_KABI_USE(6..8) below.
+	 */
 #ifdef CONFIG_DETECT_HUNG_TASK
 	unsigned long			last_switch_count;
 	unsigned long			last_switch_time;
@@ -1553,9 +1554,19 @@ struct task_struct {
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
 	ANDROID_KABI_RESERVE(5);
-	ANDROID_KABI_RESERVE(6);
-	ANDROID_KABI_RESERVE(7);
-	ANDROID_KABI_RESERVE(8);
+	/*
+	 * LuneOS: SysV IPC in reserved padding. genksyms still sees the
+	 * reserved u64s, so CRCs and offsets match the SYSVIPC=n KMI.
+	 * sysv_sem is one pointer (one slot), sysv_shm a list_head (two).
+	 */
+#ifdef CONFIG_ANDROID_KABI_RESERVE
+	ANDROID_KABI_USE(6, struct sysv_sem sysvsem);
+	_ANDROID_KABI_REPLACE(_ANDROID_KABI_RESERVE(7); _ANDROID_KABI_RESERVE(8),
+			      struct sysv_shm sysvshm);
+#else
+	struct sysv_sem			sysvsem;
+	struct sysv_shm			sysvshm;
+#endif
 
 	/*
 	 * New fields for task_struct should be added above here, so that
@@ -1574,6 +1585,13 @@ struct task_struct {
 	 */
 };
 
+#if defined(CONFIG_SYSVIPC) && defined(CONFIG_ANDROID_KABI_RESERVE)
+static_assert(sizeof(struct sysv_sem) == sizeof(u64),
+	      "sysv_sem must occupy exactly one ANDROID_KABI reserved slot");
+static_assert(sizeof(struct sysv_shm) == 2 * sizeof(u64),
+	      "sysv_shm must occupy exactly two ANDROID_KABI reserved slots");
+#endif
+
 static inline struct pid *task_pid(struct task_struct *task)
 {
 	return task->thread_pid;
-- 
