+                    app = app,
+                    sandboxManager = sandboxManager
+                )
+            }
+
             item { Spacer(modifier = Modifier.height(24.dp)) }
         }
     }
@@ -1535,6 +1606,17 @@ private fun AppQuickActionsSheet(
                     sandboxManager = sandboxManager
                 )
             }
