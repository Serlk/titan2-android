    <string name="bootlog_title">Boot log</string>
    <string name="bootlog_summary">Kernel log and logcat of every boot are kept in /metadata (they survive a boot loop and a data wipe in the bootloader) and copied to /data/local/tmp/titan2log after boot. For troubleshooting: the logs can contain personal data.</string>
    <string name="verbose_boot_title">Verbose boot</string>
    <string name="verbose_boot_summary">Show the kernel log and logcat on screen during boot, like on a desktop Linux, instead of the boot animation.</string>
    <string name="firewall_title">Firewall</string>
    <string name="firewall_summary">Internet access per app</string>
    <string name="firewall_note">Turned off = the app gets no network at all: Wi-Fi, mobile data and VPN. System services without an icon are not listed.</string>
