-IS_ANDROID_10 := $(shell test $(ANDROID_VERSION_MAJOR) -ge 10 && echo true)
-IS_ANDROID_11 := $(shell test $(ANDROID_VERSION_MAJOR) -ge 11 && echo true)
-
-ifeq ($(IS_ANDROID_5),true)
-LOCAL_C_INCLUDES += system/media/camera/include
