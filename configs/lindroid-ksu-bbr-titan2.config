# Halium/Droidian for the Titan 2 on top of gki_defconfig (GKI android14-6.1, KMI-safe).
# Based on: droidian-devices/common_fragments@6.1-android-common + LuneOS
# meta-smartphone linux-halium-gki.
# Each group was checked with scripts/bisect-kmi.sh: 0 of the 462 stock modules break.
#
# KMI POISONS (do NOT enable): CONFIG_CGROUP_DEVICE, CONFIG_CGROUP_PIDS (388 modules),
# CONFIG_FANOTIFY, CONFIG_NET_L3_MASTER_DEV (according to LuneOS).
# SYSVIPC only together with patches/kernel/0001-sched-park-SysV-IPC-in-ANDROID_KABI-reserved-padding.patch.

# --- systemd / udev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_VT=y
CONFIG_NULL_TTY=y
# CONFIG_STATIC_USERMODEHELPER is not set
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""

# --- namespaces (Android LXC container, Waydroid, Flatpak)
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CHECKPOINT_RESTORE=y

# --- SysV/POSIX IPC (KMI is kept by patch 0001)
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y

# --- stock modules are not signed with our key: without this Wi-Fi/BT do not load
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_PROTECT is not set

# --- Droidian: squashfs, Waydroid, Bluetooth via bluebinder
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
CONFIG_BT_HCIVHCI=y

# --- Lindroid: EVDI virtual display (src/lindroid-drm-loopback, built in)
CONFIG_DRM_LINDROID_EVDI=y
# CGROUP_DEVICE is not enabled: it changes the KMI and the vendor cpuqos_v3 module crashes with it

# --- KernelSU v3.3.0 (patches/kernel/0003), built in; needs KPROBES (present in gki_defconfig)
CONFIG_KSU=y

# TCP BBR
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y

# MTK mali_kbase r44 in a PID namespace (Lindroid): kprobe fix for find_get_pid
CONFIG_TITAN2_MALI_PIDNS_FIX=y
