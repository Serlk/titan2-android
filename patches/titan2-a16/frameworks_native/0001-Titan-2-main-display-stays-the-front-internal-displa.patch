From 6353a4af8dda0743f43e75693d7e169faa6008d0 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Fri, 23 Oct 2026 03:03:50 +0300
Subject: [PATCH] Titan 2: main display stays the front internal display

The rear screen is not a foldable panel: when the main display (primary HWC) powers on it
becomes front again, otherwise it would keep running on the rear display's vsync and rate.
With pacesetter_selection the Scheduler picks the pacesetter itself and keeps the current one
when the rates are equal, so the main display is also made the pacesetter when it turns on:
a rear display that woke first no longer paces the main one, which got no frames (lit, black)
once the rear's vsync stopped.
Only when ro.titan2.rear_display_port is set; other devices keep the AOSP behaviour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 services/surfaceflinger/SurfaceFlinger.cpp | 23 +++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 54522a9..b6dc520 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -6192,10 +6192,27 @@ void SurfaceFlinger::setPhysicalDisplayPowerMode(const sp<DisplayDevice>& displa
     // (e.g. MTK takes 300-500ms) that stalls the scheduler and leaves
     // the display blank after wake.
 
+    // Titan 2: the rear screen is not a foldable; the main display (primary HWC) is front and
+    // pacesetter again when powered on, otherwise it would run on the rear's vsync and rate.
+    // Only with the rear display configured: foldables keep the AOSP behaviour.
+    static const bool kPrimaryStaysFront =
+            base::GetIntProperty("ro.titan2.rear_display_port"s, -1) >= 0;
+
     if (mScheduler->setDisplayPowerMode(displayId, mode)) {
         onNewPacesetterDisplay();
     }
 
+    // Titan 2: with pacesetter_selection the Scheduler keeps the current pacesetter when the
+    // rates are equal, so a rear display that woke first kept pacing the main one after it
+    // turned on, and the main got no frames once the rear's vsync stopped.
+    if (kPrimaryStaysFront && mode == hal::PowerMode::ON &&
+        FlagManager::getInstance().pacesetter_selection() &&
+        displayId == getPrimaryDisplayIdLocked() &&
+        mScheduler->getPacesetterDisplayId() != displayId &&
+        mScheduler->designatePacesetterDisplay(displayId)) {
+        onNewPacesetterDisplay();
+    }
+
     const auto activeMode = display->refreshRateSelector().getActiveMode().modePtr;
     using OptimizationPolicy = gui::ISurfaceComposer::OptimizationPolicy;
     if (currentMode == hal::PowerMode::OFF) {
@@ -6207,7 +6224,11 @@ void SurfaceFlinger::setPhysicalDisplayPowerMode(const sp<DisplayDevice>& displa
         // and `frontInternalDisplay` are the same display, then the
         // `frontInternalDisplay->isPoweredOn()` below is true, such that the front internal display
         // is not detected every time it is powered on.
-        if (isInternalDisplay && (!frontInternalDisplay || !frontInternalDisplay->isPoweredOn())) {
+        // Titan 2: the main display becomes front again when powered on (kPrimaryStaysFront)
+        if (isInternalDisplay &&
+            (!frontInternalDisplay || !frontInternalDisplay->isPoweredOn() ||
+             (kPrimaryStaysFront && displayId == getPrimaryDisplayIdLocked() &&
+              frontInternalDisplay->getPhysicalId() != displayId))) {
             onNewFrontInternalDisplay(frontInternalDisplay.get(), *display);
         }
 
