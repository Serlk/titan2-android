+    // Titan 2: the rear screen group (display at port ro.titan2.rear_display_port, its own group
+    // via LocalDisplayAdapter) sleeps after its own timeout, titan2_rear_screen_off_timeout (ms)
+    private static final String TITAN2_REAR_TIMEOUT = "titan2_rear_screen_off_timeout";
+    private static final int TITAN2_REAR_DEFAULT_TIMEOUT = 30000;
+    private static final int TITAN2_REAR_PORT =
+            SystemProperties.getInt("ro.titan2.rear_display_port", -1);
+    @GuardedBy("mLock")
+    private int mTitan2RearGroupId = Display.INVALID_DISPLAY_GROUP;
+
+    @GuardedBy("mLock")
+    private boolean isTitan2RearGroupLocked(int groupId) {
+        final int port = TITAN2_REAR_PORT;
+        if (port < 0 || groupId == Display.DEFAULT_DISPLAY_GROUP) {
+            return false;
+        }
+        final int[] ids = mDisplayManagerInternal.getDisplayIdsForGroup(groupId);
+        if (ids == null) {
+            return false;
+        }
+        for (int id : ids) {
+            final DisplayInfo info = mDisplayManagerInternal.getDisplayInfo(id);
+            if (info != null && info.address instanceof DisplayAddress.Physical
+                    && ((DisplayAddress.Physical) info.address).getPort() == port) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Whether this is the rear screen group. The display may not be in the group yet when the
+     * group is added, so this is checked lazily and remembered on the first match.
+     */
+    @GuardedBy("mLock")
+    private boolean isTitan2RearPowerGroupLocked(PowerGroup powerGroup) {
+        final int groupId = powerGroup.getGroupId();
+        if (mTitan2RearGroupId != Display.INVALID_DISPLAY_GROUP) {
+            return groupId == mTitan2RearGroupId;
+        }
+        if (!isTitan2RearGroupLocked(groupId)) {
+            return false;
+        }
+        mTitan2RearGroupId = groupId;
+        applyTitan2RearTimeoutLocked();
+        return true;
+    }
+
+    @GuardedBy("mLock")
+    private void applyTitan2RearTimeoutLocked() {
+        final PowerGroup group = mPowerGroups.get(mTitan2RearGroupId);
+        if (group == null) {
+            return;
+        }
+        // A device setting: Titan2Parts (system uid, user 0) writes it for the system user
+        final int timeout = Settings.System.getIntForUser(mContext.getContentResolver(),
+                TITAN2_REAR_TIMEOUT, TITAN2_REAR_DEFAULT_TIMEOUT, UserHandle.USER_SYSTEM);
+        group.setScreenOffTimeoutOverrideLocked(timeout > 0 ? timeout : Integer.MAX_VALUE);
+    }
+
     @GuardedBy("mLock")
     private void updateSettingsLocked() {
         final ContentResolver resolver = mContext.getContentResolver();
+        applyTitan2RearTimeoutLocked();
 
         mDreamsEnabledSetting = (Settings.Secure.getIntForUser(resolver,
                 Settings.Secure.SCREENSAVER_ENABLED,
@@ -3814,7 +3884,9 @@ public final class PowerManagerService extends SystemService
      */
