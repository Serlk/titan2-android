From 2472d151aed5d3e73de539f98927e4db99d74b93 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Mon, 19 Oct 2026 17:22:27 +0300
Subject: [PATCH] Titan 2: do not ship phh-remotectl

adb over TCP plus an ssh tunnel to android-remote.phh.me without host key
checking, enabled by a single persist.sys.phh.remote property.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 base.mk | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/base.mk b/base.mk
index a23a98d..fb3dfb2 100644
--- a/base.mk
+++ b/base.mk
@@ -189,11 +189,8 @@ PRODUCT_COPY_FILES += \
     device/phh/treble/privapp-permissions-me.phh.treble.app.xml:system/etc/permissions/privapp-permissions-me.phh.treble.app.xml \
     device/phh/treble/sysconfig-me.phh.treble.app.xml:system/etc/sysconfig/sysconfig-me.phh.treble.app.xml
 
-# Remote debugging
-PRODUCT_COPY_FILES += \
-    device/phh/treble/remote/dbclient:system/bin/dbclient \
-    device/phh/treble/remote/phh-remotectl.rc:system/etc/init/phh-remotectl.rc \
-    device/phh/treble/remote/phh-remotectl.sh:system/bin/phh-remotectl.sh \
+# Remote debugging (phh-remotectl: adb over TCP + ssh tunnel to android-remote.phh.me without
+# host key checking) is not shipped on Titan 2: one persist.sys.phh.remote away from remote adb.
 
 PRODUCT_PACKAGES += \
     android.hardware.biometrics.fingerprint@2.1-service.oppo.compat \
-- 
2.56.0

