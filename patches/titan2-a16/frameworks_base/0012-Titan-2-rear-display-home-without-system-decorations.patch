diff --git a/services/core/java/com/android/server/wm/Titan2RearDecor.java b/services/core/java/com/android/server/wm/Titan2RearDecor.java
new file mode 100644
index 000000000..005e5540c
--- /dev/null
+++ b/services/core/java/com/android/server/wm/Titan2RearDecor.java
@@ -0,0 +1,76 @@
+/*
+ * Copyright (C) 2026 serlk
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.wm;
+
+import android.content.ContentResolver;
+import android.database.ContentObserver;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.view.DisplayAddress;
+
+/**
+ * Titan 2: the rear display (port ro.titan2.rear_display_port) is a home display for the rear
+ * shell. System decorations (status bar, shade, navigation bar, back gesture, wallpaper) are off
+ * there unless the user turns them on in Titan2Parts (Settings.System titan2_rear_system_decors).
+ * The setting wins over the persisted display_settings.xml entry.
+ */
+final class Titan2RearDecor {
+    static final String SETTING = "titan2_rear_system_decors";
+    private static final int PORT = SystemProperties.getInt("ro.titan2.rear_display_port", -1);
+
+    private static volatile boolean sShow;
+
+    private Titan2RearDecor() {
+    }
+
+    static boolean isRear(DisplayContent dc) {
+        return PORT >= 0 && dc.getDisplayInfo().address instanceof DisplayAddress.Physical p
+                && p.getPort() == PORT;
+    }
+
+    static boolean shouldShow() {
+        return sShow;
+    }
+
+    static void start(WindowManagerService wms) {
+        if (PORT < 0) {
+            return;
+        }
+        final ContentResolver cr = wms.mContext.getContentResolver();
+        cr.registerContentObserver(Settings.System.getUriFor(SETTING), false,
+                new ContentObserver(wms.mH) {
+                    @Override
+                    public void onChange(boolean selfChange) {
+                        update(wms, cr);
+                    }
+                }, UserHandle.USER_ALL);
+        update(wms, cr);
+    }
+
+    private static void update(WindowManagerService wms, ContentResolver cr) {
+        final boolean show =
+                Settings.System.getIntForUser(cr, SETTING, 0, UserHandle.USER_SYSTEM) == 1;
+        synchronized (wms.mGlobalLock) {
+            if (show == sShow) {
+                return;
+            }
+            sShow = show;
+            wms.mRoot.forAllDisplays(dc -> {
+                if (!isRear(dc)) {
+                    return;
+                }
+                wms.mDisplayWindowSettings.setShouldShowSystemDecorsInternalLocked(dc, show);
+                dc.getDisplayPolicy().updateHasNavigationBarIfNeeded();
+                if (show) {
+                    wms.mRoot.startSystemDecorations(dc, "titan2_rear_system_decors");
+                } else {
+                    dc.getDisplayPolicy().notifyDisplayRemoveSystemDecorations();
+                }
+            });
+        }
+    }
+}
