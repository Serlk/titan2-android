From ff460678c1d268ced8941d913893e803eb7c32dd Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Sun, 18 Oct 2026 15:02:11 +0300
Subject: [PATCH] CallRecorder: allow call recording regardless of country

---
 java/com/android/incallui/call/CallRecorder.java | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/java/com/android/incallui/call/CallRecorder.java b/java/com/android/incallui/call/CallRecorder.java
index 3bdabe5..1156d94 100644
--- a/java/com/android/incallui/call/CallRecorder.java
+++ b/java/com/android/incallui/call/CallRecorder.java
@@ -110,10 +110,9 @@ public class CallRecorder implements CallList.Listener {
           loadAllowedStates();
       }
 
-      String currentCountryIso = GeoUtil.getCurrentCountryIso(context);
-      Boolean allowedState = RECORD_ALLOWED_STATE_BY_COUNTRY.get(currentCountryIso);
-
-      return allowedState != null && allowedState;
+      // Titan 2: call recording is available in any country (and with no known country:
+      // no SIM, roaming). Complying with local laws is the user's responsibility.
+      return true;
   }
 
   private CallRecorder() {
-- 
2.56.0

